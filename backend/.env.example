# Puerto donde corre la API
PORT=3010

# Cadena de conexión a PostgreSQL
# formato: postgresql://usuario:password@host:puerto/nombre_bd
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/control_de_gastos

# Clave secreta para firmar los JWT (cámbiala por una propia)
JWT_SECRET=cambia_esta_clave_por_una_bien_larga_y_secreta
JWT_EXPIRES_IN=1h

# Google OAuth: Client ID de la aplicación (es PÚBLICO, no es un secreto).
# El backend lo usa para verificar el id_token que manda Angular.
# Se obtiene en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
